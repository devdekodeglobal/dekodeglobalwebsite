{
  "name": "dekode_conversational_ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "knowledge:build": "node scripts/build-company-knowledge.mjs",
    "knowledge:build:optional": "node scripts/build-company-knowledge.mjs --optional",
    "proposal:build": "node scripts/build-proposal-content.mjs",
    "prebuild": "npm run knowledge:build:optional && npm run proposal:build",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/inject-seo-content.mjs",
    "build:vercel": "vite build && node scripts/inject-seo-content.mjs",
    "lint": "oxlint",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^12.42.2",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.26.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
