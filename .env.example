# Client-safe feature configuration only. Never put provider secrets in VITE_* variables.
VITE_DEKODE_VOICE_ENABLED=true
VITE_VOICE_PROVIDER=browser
VITE_VOICE_FALLBACK_ENABLED=true
VITE_MOCK_MEETING_SLOTS_ENABLED=false
VITE_MEETING_PROVIDER=calendar
VITE_COMPANY_TIMEZONE=Asia/Kolkata
VITE_LEAD_NOTIFICATION_MODE=mock
VITE_LEAD_NOTIFICATION_ENDPOINT=/api/leads
VITE_CLIENT_PROPOSALS_ENABLED=true
VITE_PROPOSAL_CHAT_ENABLED=true
VITE_PROPOSAL_ACCESS_MODE=password_only

# Server-only. Generate a long random value for each production environment.
# Never prefix this variable with VITE_.
PROPOSAL_SESSION_SECRET=

# Server-only Gemini configuration for the DEKODE public-company chat.
# Add these in Vercel Project Settings > Environment Variables. Never use VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Server-only Google Calendar OAuth configuration. Never prefix these with VITE_.
# The calendar ID can temporarily be yuvraj.sharma@dekodeglobal.com and later be
# replaced with contactus@dekodeglobal.com without changing application code.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_BUSINESS_DAYS=1,2,3,4,5
GOOGLE_CALENDAR_WORKDAY_START=09:00
GOOGLE_CALENDAR_WORKDAY_END=17:00
GOOGLE_CALENDAR_MEETING_DURATION_MINUTES=30
GOOGLE_CALENDAR_BUFFER_MINUTES=15
GOOGLE_CALENDAR_MINIMUM_NOTICE_HOURS=24
GOOGLE_CALENDAR_DAYS_TO_SEARCH=14
GOOGLE_CALENDAR_MAXIMUM_SLOTS=18
